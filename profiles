)

declare -Ag r2s=(
  [device]="friendlyarm_nanopi-r2s"
  [target]="rockchip/armv8"
  [filesystem]="ext4"
  [packages]="${default_router[*]} \
    kmod-usb-net-rtl8152 \
    luci-app-upnp luci-app-pbr -dnsmasq dnsmasq-full smcroute"
)

